GEMINI_API_KEY=$key = (Get-Clipboard -Raw).Trim()

if ($key.Length -lt 20) {
    throw "Clipboard does not contain the full API key. Copy it again from Google AI Studio."
}

[System.IO.File]::WriteAllText(
    "$PWD\.env",
    "GEMINI_API_KEY=$key`n",
    [System.Text.UTF8Encoding]::new($false)
)

Remove-Variable key

Write-Host "ENV FILE RECREATED SUCCESSFULLY"
